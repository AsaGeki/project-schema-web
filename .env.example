# Ambiente: dev | debug | prod
NODE_ENV=dev
PORT=3000
URL=localhost

# Origens liberadas no CORS: lista separada por vírgula, ou * para liberar todas
CORS=*
JSON_LIMIT=2mb

# Log de cada requisição no console (método, rota, status, duração)
ENABLE_ROUTER_MONITORING=false

# HTTPS: preencha os três para o servidor subir com TLS; vazio sobe em HTTP
HTTPS_KEY=
HTTPS_CERT=
HTTPS_CA=

# Persistência relacional (Prisma). Vazio desliga.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/banco

# Persistência de documento (Mongoose). Vazio desliga.
MONGO_URL=

# Autenticação
JWT_SECRET=troque-este-valor
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=troque-este-valor-tambem
JWT_REFRESH_EXPIRES_IN=12h
