# ============================================
# SERVIDOR
# ============================================
# development | production | test. Produção registra no log só `error` e
# `notice` (corta `warn`, `info` e `debug`), liga o rate limit e o
# `credentials` do CORS, escolhe MONGODB_URI em vez de MONGODB_URI_DEV e
# esconde a mensagem de erro interno da resposta.
NODE_ENV=development
# Porta em que o processo escuta, em qualquer ambiente.
PORT=3000
# Host deste backend, sem protocolo nem porta. Tudo rodando na sua própria
# máquina: localhost; com outras máquinas envolvidas: o hostname desta.
SELF_HOST=localhost
# URL pública pela qual o navegador chega a este backend. Com https, os cookies
# de token saem com Secure e com o prefixo __Host-.
PUBLIC_URL=http://localhost:3000
# Origens liberadas no CORS: lista separada por vírgula, ou * para liberar todas.
CORS=*
# Limite de tamanho do corpo JSON. Acima dele a resposta é 413.
JSON_LIMIT=2mb
# Quantos proxies reversos existem na frente desta API. Define até onde o
# x-forwarded-for é confiável; 0 descarta o header, que é o certo quando a API
# é exposta direto. Conte cada salto que acrescenta o header (nginx, rewrite do
# front). Valor maior que o real deixa o cliente escolher o próprio IP e
# enganar o rate limit.
TRUST_PROXY=0
# Log de cada requisição no console: método, rota, status, duração e IP de origem.
ENABLE_ROUTER_MONITORING=false
# Teto de memória usado no percentual do /api/health, em MB. Vazio usa a RAM da
# máquina inteira; em container, informe o limite real.
MEMORY_LIMIT_MB=

# ============================================
# HTTPS (opcional)
# ============================================
# Caminho dos arquivos de chave e certificado. Com os dois preenchidos o
# servidor sobe em TLS; vazio sobe em HTTP. HTTPS_CA é opcional.
HTTPS_KEY=
HTTPS_CERT=
HTTPS_CA=

# ============================================
# BANCO DE DADOS
# ============================================
# Postgres via Prisma, em qualquer ambiente. Vazio desliga a persistência
# relacional: o servidor sobe, mas rota que toca o Postgres falha.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/banco
# Mongo via Mongoose. MONGODB_URI vale em produção; MONGODB_URI_DEV no resto.
# Vazia a do ambiente atual, a conexão com o Mongo é ignorada.
MONGODB_URI=
MONGODB_URI_DEV=mongodb://localhost:27017/banco

# ============================================
# AUTENTICAÇÃO (JWT)
# ============================================
# Obrigatórias: sem elas o boot falha. Os dois segredos precisam ser diferentes.
JWT_SECRET=troque-este-valor
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=troque-este-valor-tambem
JWT_REFRESH_EXPIRES_IN=12h
# Chave da cifra dos cookies de token (AES-256-GCM), com no mínimo 32
# caracteres. Obrigatória. Trocá-la derruba todas as sessões em cookie.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOKEN_COOKIE_ENCRYPTION_KEY=troque-este-valor-por-32-caracteres-ou-mais
# Nome dos cookies de token. Em origem https o nome ganha o prefixo __Host-.
ACCESS_TOKEN_COOKIE_NAME=access_token
REFRESH_TOKEN_COOKIE_NAME=refresh_token
# Validade do cookie do refresh token, em milissegundos (7 dias).
REFRESH_TOKEN_COOKIE_TTL_MS=604800000
# Origens aceitas como URL de retorno, separadas por vírgula. Vazio recusa todas.
ALLOWED_RETURN_ORIGINS=
# Valor do header X-Requested-By que o front manda em POST, PUT, PATCH e
# DELETE. Não é segredo: prova que a chamada saiu de fetch do próprio front.
CSRF_HEADER_VALUE=project-schema

# ============================================
# API KEYS HMAC (server-to-server)
# ============================================
# Quem pode chamar as rotas assinadas deste backend. Formato
# "id1:secret1,id2:secret2"; entrada malformada é descartada.
API_KEYS_HMAC=
# Janela de tolerância do timestamp assinado, em milissegundos. Requisição
# assinada fora dela é recusada, o que impede reenviar uma captura antiga.
API_KEYS_HMAC_TOLERANCIA_MS=300000

# ============================================
# UPLOADS
# ============================================
# Raiz dos arquivos enviados. Fora de produção fica no projeto (ignorada pelo
# git); em produção, aponte para uma pasta fora dele, para o deploy não apagar
# os arquivos.
UPLOADS_DIR=./uploads
# Tamanho máximo de cada arquivo enviado: número seguido de B, KB, MB ou GB.
MAX_FILE_SIZE=50MB

# ============================================
# SEED
# ============================================
# Usuário administrador criado pelo `pnpm db:seed`. Ausentes, valem
# admin@exemplo.com / admin@123 — troque fora do ambiente local. Descomente só com
# valor: presente e vazia, a variável vira e-mail ou senha vazios.
# SEED_ADMIN_EMAIL=admin@empresa.com
# SEED_ADMIN_PASSWORD=troque-esta-senha

# ============================================
# TESTES DE INTEGRAÇÃO (`pnpm test:integration`)
# ============================================
# Bancos exclusivos da integração: o schema é aplicado no Postgres, cada teste
# limpa as tabelas que usa e o Mongo é removido no fim. A execução falha se a
# URL faltar, for igual à de desenvolvimento ou apontar para banco cujo nome não
# termina em "_test".
DATABASE_URL_TEST=postgresql://usuario:senha@localhost:5432/banco_test
MONGODB_URI_TEST=mongodb://localhost:27017/banco_test
