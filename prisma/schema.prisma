generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String   @id @default(uuid())
  name     String   @db.VarChar(120)
  email    String   @unique
  password String
  perfis   Perfil[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@map("users")
}

/// Grupo do catálogo de permissões (`users`, `logs`). Sincronizado pelo seed.
model GrupoPermissao {
  id         String      @id @default(uuid())
  slug       String      @unique
  nome       String
  permissoes Permissao[]

  @@map("grupos_permissao")
}

/// Ação de um grupo; a permissão completa é `grupo.slug:acao`.
model Permissao {
  id      String            @id @default(uuid())
  grupoId String
  acao    String
  grupo   GrupoPermissao    @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  perfis  PerfilPermissao[]

  @@unique([grupoId, acao])
  @@map("permissoes")
}

model Perfil {
  id              String            @id @default(uuid())
  nome            String            @unique @db.VarChar(80)
  descricao       String?           @db.VarChar(255)
  /// Equivale a `*`: todas as permissões, atuais e futuras. Só o seed cria.
  todasPermissoes Boolean           @default(false)
  permissoes      PerfilPermissao[]
  usuarios        User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@map("perfis")
}

model PerfilPermissao {
  perfilId    String
  permissaoId String
  perfil      Perfil    @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  permissao   Permissao @relation(fields: [permissaoId], references: [id], onDelete: Cascade)

  @@id([perfilId, permissaoId])
  @@map("perfis_permissoes")
}
